pipeline{
     agent any
    stages{
        stage('Build'){
            steps{
                echo 'This is rcbs first declaration of build stage'
            }
        }
         stage('Deploy'){
            steps{
                echo 'This is rcbs first declaration of Deploy1 stage'
                echo 'This is the latest one'
            }           
        }
        stage('Test'){
            steps{
                echo 'This is rcbs first declaration of Test stage'
            }
        }
         stage('Test webhooks'){
        steps{
            echo 'Testing webhooks'
        }
    }
    }
    post{
        always{
            echo 'This is rcbs first declaration of post stage'
            echo 'This is the latest one for POLL SCM change'
            echo 'This is the latest one for POLL SCM change2'
            echo 'This is the latest one for POLL SCM change3'
            echo 'This is the latest one for POLL SCM change4'
            cleanWs()
        }
    }
   
}